<Window x:Class="drcom4scutGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:drcom4scutGUI"
        mc:Ignorable="d"
        Title="drcom4scutGUI" SizeToContent="Height" Width="480" ResizeMode="CanMinimize"
        Closing="Window_Closing" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" StateChanged="Window_StateChanged" Icon="DrClient.ico">

    <Window.Resources>
        <Style TargetType="Label" x:Key="LabelStyle">
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Control" x:Key="ControlStyle">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0,5,0,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="Margin" Value="10,0,10,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Content="模式" Style="{StaticResource LabelStyle}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="modeComboBox" SelectedValuePath="Tag" Style="{StaticResource ControlStyle}" SelectionChanged="ModeComboBox_SelectionChanged">
                <ComboBoxItem Content="有线 EAP + UDP" Tag="eap" />
                <ComboBoxItem Content="有线仅 EAP" Tag="eap-only" />
                <ComboBoxItem Content="无线 Portal" Tag="portal" />
            </ComboBox>
            <Label Grid.Row="1" Content="网卡(_N)" Target="{Binding ElementName=macComboBox}" Style="{StaticResource LabelStyle}" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="macComboBox" SelectedValuePath="Tag" Style="{StaticResource ControlStyle}" />

            <Label Grid.Row="2" Target="{Binding ElementName=nameComboBox}" Content="账号(_U)" Style="{StaticResource LabelStyle}" />
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="nameComboBox" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource ControlStyle}" />
                <Button Grid.Column="1" x:Name="deleteButton" Content="删除" IsEnabled="False" MinWidth="40" Padding="6,0,6,0" Margin="6,5,0,5" Click="DeleteButton_Click" />
            </Grid>

            <Label Grid.Row="3" Content="密码(_P)" Target="{Binding ElementName=passwordTextBox}" Style="{StaticResource LabelStyle}" />
            <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="passwordTextBox" Style="{StaticResource ControlStyle}" />

            <Label Grid.Row="4" Content="本机源 _IP" Target="{Binding ElementName=ipTextBox}" Style="{StaticResource LabelStyle}" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="ipTextBox" Style="{StaticResource ControlStyle}" TextChanged="IpTextBox_TextChanged" />
        </Grid>

        <GroupBox Grid.Row="1" x:Name="portalPanel" Header="无线门户（显式配置可信地址）" Visibility="Collapsed" Margin="0,6,0,0">
            <Grid Margin="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="门户地址" Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="portalBaseTextBox" Style="{StaticResource ControlStyle}" ToolTip="填写明确可信的 HTTPS 门户地址，不自动猜测或跟随其他主机。" />
                <Label Grid.Row="1" Content="API 地址" Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="portalApiTextBox" Style="{StaticResource ControlStyle}" ToolTip="可选；必须使用同一可信主机，不允许 HTTPS 降级为 HTTP。" />
                <Label Grid.Row="2" Content="AC IPv4" Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="portalAcIpTextBox" Style="{StaticResource ControlStyle}" ToolTip="可选的接入控制器 IPv4；留空由门户流程发现。" />
                <Label Grid.Row="3" Content="载荷 IPv4" Style="{StaticResource LabelStyle}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="portalClientIpTextBox" Style="{StaticResource ControlStyle}" ToolTip="提交给门户的客户端 IPv4，与上方实际网络源 IP 分开；留空由门户发现。" />
                <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="allowHttpCheckBox" Content="允许 HTTP 门户明文网络传输（默认关闭）" Margin="0,6" Checked="Preferences_Changed" Unchecked="Preferences_Changed" />
                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="DarkRed" TextWrapping="Wrap" Text="HTTP 会将账号密码明文发送到远端门户。仅在确认校园门户必须使用 HTTP 且接受此风险时勾选；程序不会自动回退 HTTP。" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,9,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <CheckBox x:Name="autoCheckBox" Content="打开 GUI 后自动认证(_A)" Margin="0,3" Checked="Preferences_Changed" Unchecked="Preferences_Changed" />
                <CheckBox x:Name="startupCheckBox" Content="Windows 登录时启动" Margin="0,3" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="loginButton" Content="认证" IsDefault="True" Background="ForestGreen" Style="{StaticResource ButtonStyle}" Click="LoginButton_Click" />
        </Grid>

        <GroupBox Grid.Row="3" Header="状态">
            <TextBlock x:Name="label" Padding="4" TextWrapping="Wrap" Text="正在检查核心版本和加密账号配置…" />
        </GroupBox>
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="doctorButton" Content="环境自检" Padding="8,3" Click="DoctorButton_Click" />
                <Button Content="导出诊断" Padding="8,3" Margin="8,0,0,0" Click="ExportButton_Click" />
            </StackPanel>
            <TextBox x:Name="logTextBox" IsReadOnly="True" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
