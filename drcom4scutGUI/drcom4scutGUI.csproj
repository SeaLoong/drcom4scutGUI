<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RootNamespace>drcom4scutGUI</RootNamespace>
    <AssemblyName>drcom4scutGUI</AssemblyName>
    <ApplicationIcon>DrClient.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../drcom4scutGUI.Core/drcom4scutGUI.Core.csproj" />
    <Resource Include="DrClient.ico" />
  </ItemGroup>
</Project>
