<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <RootNamespace>drcom4scutGUI</RootNamespace>
    <AssemblyName>drcom4scutGUI</AssemblyName>
    <ApplicationIcon>DrClient.ico</ApplicationIcon>
    <DefineConstants Condition="'$(ScreenshotCapture)' == 'true'">$(DefineConstants);SCREENSHOT_CAPTURE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <ProjectReference Include="../drcom4scutGUI.Core/drcom4scutGUI.Core.csproj" />
    <AvaloniaResource Include="DrClient.ico" />
  </ItemGroup>
</Project>
